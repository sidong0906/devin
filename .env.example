# Application role: no UPDATE/DELETE on audit_events, no UPDATE on approval_requests.payload
DATABASE_URL=postgres://tools_app:tools_app@localhost:5432/tools
# Migration role: owns schema
MIGRATION_DATABASE_URL=postgres://tools_migrator:tools_migrator@localhost:5432/tools
NODE_ENV=development
DEMO_AUTH=true
SESSION_SECRET=dev-only-change-me
API_PORT=4000
WEB_PORT=5173
PAYMENT_SIMULATOR_URL=http://localhost:4100
PAYMENT_SIMULATOR_PORT=4100

# Optional, dev server only: extra hostnames Vite may serve (e.g. a tunnel/preview host), comma-separated
# WEB_ALLOWED_HOSTS=
# Optional: browser origin the API accepts for mutations when it differs from the request host
# WEB_ORIGIN=
